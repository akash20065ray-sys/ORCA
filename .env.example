# ===================================================
# ORCA Environment Configuration
# ===================================================

# LLM Configuration (Anthropic Claude)
# If left empty, ORCA automatically operates using high-precision grounded local heuristics and zero-hallucination structured synthesis.
ANTHROPIC_API_KEY=

# Supabase / PostgreSQL Configuration (Optional for cloud PostGIS storage)
# If left empty, ORCA operates using built-in high-performance PostGIS-compatible spatial engine.
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# App Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Data Cache Duration (seconds)
CACHE_TTL_SECONDS=1800
